#!/bin/sh
set -eu
if [ "$1" != "origin" ] || [ "$2" != "https://github.com/abakrtechhub/ImageRefresh.git" ]; then
  echo 'Push blocked: unexpected remote.' >&2
  exit 1
fi
while read local_ref local_sha remote_ref remote_sha; do
  powershell.exe -NoProfile -File tools/Test-Push.ps1 -Commit "$local_sha" -Branch "$remote_ref" || exit 1
done
